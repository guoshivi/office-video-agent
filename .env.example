# Local runtime data. Keep this directory out of Git.
OVA_DATA_DIR=./data
OVA_HOST=127.0.0.1
# Keep 8770: the existing video workbench uses 8765 and its healthcheck owns that port.
OVA_PORT=8770

# Existing local video workbench (same machine is assumed).
WORKBENCH_URL=http://YOUR-WORKBENCH-IP:8765
WORKBENCH_ORIGIN=
WORKBENCH_OUTPUT_ROOT=./data/workbench_outputs
# 工作台只接受授权根目录内的素材，留空则自动读取工作台 /api/roots 的第一个可用目录
WORKBENCH_MATERIAL_ROOT=

# Reuse the video workbench's local EmbeddingGemma2 model.
# Set these paths after the application is installed on the target computer.
SEMANTIC_PROVIDER=workbench_cli
SEMANTIC_MODEL=embeddinggemma-2
SEMANTIC_WORKBENCH_ROOT=
SEMANTIC_WORKBENCH_PYTHON=
SEMANTIC_MODEL_DIR=
SEMANTIC_GPU_LOCK_PATH=

# Alternative: an OpenAI-compatible embedding HTTP service.
# SEMANTIC_PROVIDER=http
# SEMANTIC_BASE_URL=http://127.0.0.1:8000/v1
# SEMANTIC_API_KEY=
# SEMANTIC_EMBEDDINGS_PATH=/embeddings

# ---------------------------------------------------------------- 飞书（可选）
# 企业自建应用的凭据，只在本地 .env 里保存，绝不提交到 GitHub。
# 详细开通步骤见 docs/feishu-setup.md
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn
# 多维表格（任务面板）App Token 与表 ID，留空则只回飞书消息、不写表
FEISHU_BASE_APP_TOKEN=
FEISHU_PROPERTY_TABLE_ID=
FEISHU_TASK_TABLE_ID=
# 收完房源信息后是否自动出片（0=等一条「出片」指令，1=立刻提交）
FEISHU_AUTO_RENDER=0

# 成片和 WebUI 链接里可以带上的本机访问地址，例如 http://192.168.31.79:8770
OVA_PUBLIC_URL=
