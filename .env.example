# Local runtime data. Keep this directory out of Git.
OVA_DATA_DIR=./data
OVA_HOST=127.0.0.1
# Keep 8770: the existing video workbench uses 8765 and its healthcheck owns that port.
OVA_PORT=8770

# Existing local video workbench (same machine is assumed).
WORKBENCH_URL=http://YOUR-WORKBENCH-IP:8765
WORKBENCH_ORIGIN=
WORKBENCH_OUTPUT_ROOT=./data/workbench_outputs
# 工作台只接受授权根目录内的素材，留空则自动读取工作台 /api/roots 的第一个可用目录
WORKBENCH_MATERIAL_ROOT=

# Reuse the video workbench's local EmbeddingGemma2 model.
# Set these paths after the application is installed on the target computer.
SEMANTIC_PROVIDER=workbench_cli
SEMANTIC_MODEL=embeddinggemma-2
SEMANTIC_WORKBENCH_ROOT=
SEMANTIC_WORKBENCH_PYTHON=
SEMANTIC_MODEL_DIR=
SEMANTIC_GPU_LOCK_PATH=

# Alternative: an OpenAI-compatible embedding HTTP service.
# SEMANTIC_PROVIDER=http
# SEMANTIC_BASE_URL=http://127.0.0.1:8000/v1
# SEMANTIC_API_KEY=
# SEMANTIC_EMBEDDINGS_PATH=/embeddings

# ---------------------------------------------------------------- 飞书（可选）
# 企业自建应用的凭据，只在本地 .env 里保存，绝不提交到 GitHub。
# 详细开通步骤见 docs/feishu-setup.md
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn
# 多维表格（任务面板）App Token 与表 ID，留空则只回飞书消息、不写表
FEISHU_BASE_APP_TOKEN=
FEISHU_PROPERTY_TABLE_ID=
FEISHU_TASK_TABLE_ID=
# 收完房源信息后是否自动出片（0=等一条「出片」指令，1=立刻提交）
FEISHU_AUTO_RENDER=0

# 成片和 WebUI 链接里可以带上的本机访问地址，例如 http://192.168.31.79:8770
OVA_PUBLIC_URL=

# ---------------------------------------------------------------- 视频分析
# 留空则依次找 PATH 和工作台试用包自带的那个
FFMPEG_PATH=
# 分镜切段时长（秒）。房源实拍用 6 秒左右比较稳，镜头少可以调到 4。
# 出片观感（工作台原生支持）
# 贴纸：工作台让模型挑图标，模型给出不存在的资源名会让整条出片失败，
# 所以默认关；确认 assets/stickers 齐全后再打开。
OVA_RENDER_STICKER=0
OVA_RENDER_FLOWER=0
OVA_RENDER_SFX=0
# 句间停顿，0.10–1.00，长一点更像人说话
OVA_RENDER_SENTENCE_GAP=0.22

# ---------------------------------------------------------------- 多维表格
# 方案 A（消息走 WorkBuddy 的飞书通道）下，要写多维表格仍然需要一个自建应用的
# App ID / App Secret + bitable:app 权限。写表只走 REST，不订阅事件，
# 所以不会和 WorkBuddy 的长连接抢消息。
# ---------------------------------------------------------------- 发布（可选）
# 详细说明与踩过的坑见 docs/publish.md
# 两个平台默认都关：发布是不可逆动作，确认账号环境就绪再打开。
PUBLISH_XHS_ENABLED=0
PUBLISH_DOUYIN_ENABLED=0

# 小红书：本地运行的 xiaohongshu-mcp 服务（python tools/fetch_publish_tools.py 拉取）
PUBLISH_XHS_MCP_URL=http://127.0.0.1:18060/mcp
# 服务端启用了 -token 时才需要填
PUBLISH_XHS_TOKEN=

# 抖音：CDP 附加到真实 Chrome，必须用独立 profile 起这个端口
# chrome.exe --user-data-dir=<项目>/data/chrome-profile --remote-debugging-port=9222
PUBLISH_DOUYIN_CDP_URL=http://127.0.0.1:9222

# 频率控制：中介号不是矩阵号，宁可少发也别进风控
PUBLISH_DAILY_LIMIT=3
PUBLISH_MIN_INTERVAL_MINUTES=60
# 多维表格审核通过后是否自动发（审核台接好后再打开）
PUBLISH_AUTO_AFTER_REVIEW=0

# 注意：本机若有全局代理（Clash 等），代码里所有本地请求都走了 trust_env=False，
# 但用 curl 调试时要加 --noproxy '*'，否则 localhost 会被代理接管并返回 502。
