.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.env
data/*
!data/.gitkeep
# 渲染字体与图标是程序资产（不是运行数据），要跟着仓库走，
# 否则新机器 clone 下来出片会因为找不到字体直接失败
!data/render-env/
!data/render-env/**
# 钩子库同理：话术是程序资产，缺了它新机器出片就退回老句式
!data/copy/
!data/copy/**
*.db
*.sqlite3
logs/
dist/
build/
.DS_Store
Thumbs.db
.pytest-data/

# 第三方发布二进制（14MB+）不进仓库，用 tools/fetch_publish_tools.py 拉取
vendor/**/*.exe
vendor/**/data/
vendor/**/cookies.json

# 交付包是构建产物，不进仓库（历史里的那个也一并清掉）
房源视频助手-源码-*.zip

# 测试数据目录（每会话独立；上一次误提交的产物也在这里清掉）
.pytest-data*/
