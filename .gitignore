.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.env
data/*
!data/.gitkeep
# 渲染字体与图标是程序资产（不是运行数据），要跟着仓库走，
# 否则新机器 clone 下来出片会因为找不到字体直接失败
!data/render-env/
!data/render-env/**
*.db
*.sqlite3
logs/
dist/
build/
.DS_Store
Thumbs.db
.pytest-data/

# 第三方发布二进制（14MB+）不进仓库，用 tools/fetch_publish_tools.py 拉取
vendor/**/*.exe
vendor/**/data/
vendor/**/cookies.json

# 交付包是构建产物，不进仓库（历史里的那个也一并清掉）
房源视频助手-源码-*.zip
